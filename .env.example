# ═══════════════════════════════════════════════════════════════════
#  Supply Chain Risk API — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── Gemini API ─────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use — gemini-1.5-flash is fast and free-tier friendly
GEMINI_MODEL=gemini-1.5-flash

# ── Supabase ───────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ── Model Paths ────────────────────────────────────────────────────
# Directory where trained model files are stored
MODEL_DIR=./models

# File names inside MODEL_DIR
MODEL_DELAY_FILE=model_delay.json
MODEL_RISK_FILE=model_risk.json
EXPLAINER_FILE=explainer.pkl
FEATURE_COLUMNS_FILE=feature_columns.json

# ── API Settings ───────────────────────────────────────────────────
# Max rows allowed per bulk CSV upload
BULK_MAX_ROWS=200

# CORS allowed origins (comma-separated, use * for dev)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ── Optional: Open-Meteo ───────────────────────────────────────────
# No API key needed — but set to false to disable if not implemented yet
WEATHER_ENABLED=false
